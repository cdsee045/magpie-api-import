{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"], "allowImportingTsExtensions": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "index.ts", "tests/core/**/*.ts"]
}
